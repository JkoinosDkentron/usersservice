##################################################
# DOMAIN INVARIANTS
##################################################

### Should fail when document contains letters
POST {{baseUrl}}/owners
Content-Type: application/json

{
  "name": "Juan",
  "lastName": "Vargas",
  "document": "ABC123",
  "phone": "+573001234567",
  "birthDate": "1995-01-01",
  "email": "juan.vargas@test.com",
  "password": "Password123"
}


### Should fail when phone format is invalid
POST {{baseUrl}}/owners
Content-Type: application/json

{
  "name": "Juan",
  "lastName": "Vargas",
  "document": "123456789",
  "phone": "ABC123",
  "birthDate": "1995-01-01",
  "email": "juan.vargas@test.com",
  "password": "Password123"
}


