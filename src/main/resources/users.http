### Variables
@baseUrl = http://localhost:8081/api/v1/users


##################################################
# CREATE OWNER - SUCCESS
##################################################

### Should create owner successfully
POST {{baseUrl}}/owners
Content-Type: application/json

{
  "name": "Juan",
  "lastName": "Vargas",
  "document": "123456789",
  "phone": "+573001234567",
  "birthDate": "1995-01-01",
  "email": "juan.vargas@test.com",
  "password": "Password123"
}


